# ==============================================================================
# KONFIGURASI DATABASE NEON POSTGRESQL
# ==============================================================================
# 1. Buka https://neon.tech dan buat akun/project baru (Gratis).
# 2. Salin Connection string (format PostgreSQL).
# 3. Paste connection string kamu ke variabel DATABASE_URL di bawah ini:
DATABASE_URL="postgresql://username:password@ep-something.us-east-2.aws.neon.tech/neondb?sslmode=require"

